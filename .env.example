# ==========================================
# VARIABLES DE ENTORNO DE LA BASE DE DATOS
# ==========================================
# Copiá este archivo a .env y completá los valores reales.
# Nombre del usuario administrador de PostgreSQL
POSTGRES_USER=roguelike_user

# Contraseña del usuario administrador de PostgreSQL (cambiala en tu entorno)
POSTGRES_PASSWORD=changeme_en_tu_entorno_local

# Nombre de la base de datos principal
POSTGRES_DB=roguelike_db

# Puerto externo mapeado en la máquina anfitriona (host)
POSTGRES_PORT=5432

# Secreto para firmar los JWT (usá un valor largo y aleatorio)
JWT_SECRET=changeme_por_un_secreto_largo_y_aleatorio
